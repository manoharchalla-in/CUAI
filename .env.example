# Application Environment Configuration Example
# Copy this file to .env or .env.local and populate with your production credentials.

# Application Environment
NODE_ENV=production
PORT=3000

# Authentication & Security
# Generate a strong 64-character secret key for JWT signing in production:
# e.g., openssl rand -base64 32
JWT_SECRET=your_secure_production_jwt_secret_key_minimum_32_characters

# AI & LLM Providers (Server-side only)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Database / Storage Configuration (Optional overrides)
# DATA_DIR=./data
